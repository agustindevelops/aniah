{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@local-sync/shared": ["packages/shared/src/index.ts"],
      "@local-sync/db": ["packages/db/src/index.ts"],
      "@local-sync/pipeline": ["packages/pipeline/src/index.ts"],
      "@local-sync/scraper": ["packages/scraper/src/index.ts"],
      "@local-sync/ai": ["packages/ai/src/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist"
  }
}
