{
  "name": "gmail-local-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Gmail sync tool with Playwright, SQLite, and Gemma via Ollama.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "dev": "npm run --workspaces --if-present dev",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
